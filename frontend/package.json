{
  "name": "wardeniq-frontend",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "WardenIQ production frontend — React + Vite + Tailwind with feature-based architecture.",
  "scripts": {
    "test": "node --test",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .jsx --report-unused-disable-directives --max-warnings 0",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6"
  }
}
