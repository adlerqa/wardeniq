# Copy to .env and adjust. `./run.sh` reads this file.
# Note: Keep comments on their own line above variables. Never place inline
# comments on value lines (e.g. KEY=val # comment), as trailing comments leak
# into values parsed by Docker Compose env_file, shell source, or dotenv parsers.

# Signs sessions and encrypts secrets stored in the DB. Change this in production.
APP_SECRET=change-me-in-production

# Set 'production' to enforce hard startup gates (strong secret, COOKIE_SECURE=true, SMTP configured) and hide API docs.
# APP_ENV=development

# Optional: split APP_SECRET's two roles. Blank = both fall back to APP_SECRET.
# SESSION_SECRET=
# ENCRYPTION_KEY=

# ---- Auth (passwordless email OTP, always on — no bypass flag) ----
# First admin on startup; blank = first person to sign in becomes admin.
ADMIN_EMAIL=
# Bootstrap password for password sign-in (used before/without SMTP). Set it (the
# installer prompts for this) to REPLACE the old admin123 default — it's seeded once
# on first boot and admin123 then stops working. Policy: >=8 chars, a letter and a
# number, not "admin123". Blank = legacy admin123 with a forced change on first login.
# Seeded onto BOTH the local `admin` account and the ADMIN_EMAIL admin above, so the
# email + password pair configured here is a working sign-in on its own. Sign in at
# the "Username or email" field with either `admin` or that email address.
ADMIN_PASSWORD=
# Set true when serving over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
OTP_TTL_SECONDS=600
# SMTP for OTP emails is configured in-app (Configuration → Email). Until it is,
# the first admin's one-time code is printed to the server log so they can sign in
# and set email up. Once SMTP is configured, codes are emailed and never logged.

# ---- LLM / embeddings (Ollama by default; hosted providers incl. AWS Bedrock are
# configured in-app under Configuration → LLM / Embeddings, not here) ----
GEN_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
GEN_TOTAL=16

# ---- GitHub (optional; also settable in-app) ----
GITHUB_TOKEN=
# Seed default for the GitHub poll cadence (seconds). The in-app Sync setting
# (Configuration → Sync & polling) overrides this once saved. Min 30s. 1800 = 30 min.
POLL_INTERVAL_SECONDS=1800
WEBHOOK_SECRET=

# ---- Database ----
DB_NAME=wardeniq
# MONGO_URI — set here to bring your own DB (Atlas, or self-managed with mongot);
# leave blank to use the bundled MongoDB. Setting it disables the bundled database.
# Can also be set from Configuration → Database in-app, which writes it back into this file.
# MONGO_URI=mongodb+srv://USER:***@your-cluster.mongodb.net/?retryWrites=true&w=majority

# ---- Bundled MongoDB authentication (OPT-IN; default off) ----
# The bundled replica set runs without auth for zero-config onboarding, and its
# ports are NOT published to the host. To turn ON authentication, don't edit these
# by hand — run ./scripts/enable-mongo-auth.sh, which generates the keyfile, creates
# the users (two-phase bootstrap), and fills these in + sets MONGO_URI and COMPOSE_FILE.
MONGO_AUTH_ENABLED=false
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# ---- Bundled images (only used with docker-compose.mongodb.yml) ----
# The bundled mongod must be 8.1+ — mongot's gRPC transport needs the
# useGrpcForSearch parameter, which 8.0.x rejects. If you override MONGO_IMAGE,
# pin 8.1 or newer.
MONGO_IMAGE=mongodb/mongodb-community-server:8.3-ubi9
MONGOT_IMAGE=mongodb/mongodb-community-search:0.65.1

# ---- App image (a client with no source points this at your published image) ----
# Which published image tag to run. 'latest' tracks every release; pin e.g. 'adlerqa/wardeniq:0.2.0' to freeze a version.
# APP_IMAGE=adlerqa/wardeniq:latest

# ---- Accuracy & verification knobs ----
# Coverage verdicts at or below this confidence are flagged 'needs review' in the result instead of being trusted outright.
# COVERAGE_REVIEW_THRESHOLD=0.7

# How many independent passes the Mind Map reviewer makes per batch (default 1). 2+ keeps a 'covered' verdict only when every pass agrees.
# MINDMAP_SAMPLES=1

# Token-similarity floor for reusing an existing API test case (default 0.35).
# WARDENIQ_REUSE_SIM_API=0.35

# Token-similarity floor for non-API test cases (default 0.65).
# WARDENIQ_REUSE_SIM_GENERAL=0.65

# Above this many cases, the in-memory exact-search fallback is skipped when vector search is down (default 20000).
# NUMPY_FALLBACK_MAX_DOCS=20000

# Characters of a single source chunk shown to the reviewer (default 4000).
# MINDMAP_EXCERPT_PER_CHARS=4000

# Total code budget per review call (characters). Derived from context window if unset.
# MINDMAP_EXCERPT_TOTAL_CHARS=

# Code budget when a hosted provider is configured (default 60000).
# MINDMAP_EXCERPT_TOTAL_CHARS_HOSTED=60000

# Output tokens reserved for the reviewer's reply (default 2000).
# MINDMAP_REVIEW_MAX_TOKENS=2000

# Hard ceiling on the context requested from a local Ollama model (default 8192).
# OLLAMA_MAX_NUM_CTX=8192

# Safety valve on the exhaustive sweep (default 0 = unlimited).
# MINDMAP_MAX_WINDOWS=0

# Test cases judged per review call (default 10).
# MINDMAP_BATCH_SIZE=10

# ---- Ollama (also settable in-app) ----
# OLLAMA_URL pins and locks the endpoint in the UI; leave blank to keep it editable.
# The fallback (OLLAMA_URL_BUNDLED) is set by the installer per mode: the bundled
# container, or your own host Ollama (http://host.docker.internal:11434) for the
# app-only flow. Only set these by hand if you skip the installer.
# OLLAMA_URL=http://host.docker.internal:11434

# ---- SMTP (optional). In-app Configuration → Email takes precedence once set; this
# is the FALLBACK — it bootstraps OTP email for the very first admin login (before you
# can sign in to configure it in-app) and covers an APP_SECRET rotation. ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_TLS=true
# SMTP_SSL=false

# ---- AWS S3 Document Storage (optional; also configurable in-app under Configuration → AWS S3 Storage) ----
# AWS_S3_BUCKET=my-wardeniq-documents-bucket
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
